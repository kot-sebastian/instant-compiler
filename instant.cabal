cabal-version:      2.4
name:               instant
version:            0.1.0.0
synopsis:           Compiler of the Instant language to JVM (Jasmin) and LLVM.
license:            MIT
license-file:       LICENSE
author:             Sebastian Kot
maintainer:         sk371043@students.mimuw.edu.pl
category:           Compiler
build-type:         Simple
tested-with:        GHC == 9.12.4
extra-source-files: README.md
                    README.pl.md
                    src/Instant.cf
data-files:         lib/jasmin.jar
                    lib/runtime.bc

common shared
  default-language: Haskell2010
  build-depends:    base >=4.9 && <5
  ghc-options:      -Wall

library
  import:             shared
  hs-source-dirs:     src
  exposed-modules:    Compiler.Backend.JVM
                      Compiler.Backend.LLVM
                      Compiler.Driver
                      Compiler.Frontend
                      Compiler.Syntax
                      -- generated by BNFC from src/Instant.cf (see `make grammar`)
                      Instant.Abs
                      Instant.Lex
                      Instant.Par
  other-modules:      Paths_instant
  autogen-modules:    Paths_instant
  build-depends:      array
                    , containers
                    , directory
                    , filepath
                    , mtl
                    , process
  build-tool-depends: alex:alex >=3.2.6
                    , happy:happy >=1.20

executable insc_jvm
  import:           shared
  hs-source-dirs:   app
  main-is:          insc_jvm.hs
  build-depends:    instant, filepath

executable insc_llvm
  import:           shared
  hs-source-dirs:   app
  main-is:          insc_llvm.hs
  build-depends:    instant, filepath

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:    instant, containers, QuickCheck >=2.10
